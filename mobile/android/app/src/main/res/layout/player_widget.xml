<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_panel" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_panel" android:orientation="vertical" android:clipToOutline="true"
    android:paddingLeft="8dp" android:paddingRight="12dp" android:paddingTop="8dp" android:paddingBottom="6dp">
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ImageView android:id="@+id/widget_cover" android:layout_width="wrap_content" android:layout_height="match_parent"
            android:layout_gravity="top|left" android:adjustViewBounds="true" android:scaleType="centerCrop"
            android:background="@drawable/widget_cover_mask" android:clipToOutline="true" android:src="@drawable/lume" android:contentDescription="打开澄音" />
        <ImageView android:id="@+id/widget_favorite" android:layout_width="36dp" android:layout_height="32dp" android:layout_gravity="top|right"
            android:layout_marginTop="2dp" android:paddingLeft="9dp" android:paddingRight="0dp" android:paddingBottom="7dp" android:src="@drawable/widget_heart" android:contentDescription="收藏" />
    </FrameLayout>
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginLeft="4dp" android:paddingTop="3dp" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end"
        android:text="澄音播放器" android:textSize="15sp" android:textStyle="bold" android:textColor="#FFFCF8" />
    <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginLeft="4dp" android:includeFontPadding="false" android:singleLine="true" android:ellipsize="end" android:textSize="12sp" android:textColor="#BCB4AD" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="37dp" android:layout_marginLeft="4dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_previous" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:padding="7dp" android:src="@drawable/widget_previous" android:contentDescription="上一首" />
        <FrameLayout android:id="@+id/widget_toggle_target" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent">
            <ImageView android:id="@+id/widget_toggle" android:layout_width="29dp" android:layout_height="29dp" android:layout_gravity="center"
                android:padding="7dp" android:src="@drawable/widget_play" android:background="@drawable/widget_accent" />
        </FrameLayout>
        <ImageView android:id="@+id/widget_next" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:padding="7dp" android:src="@drawable/widget_next" android:contentDescription="下一首" />
    </LinearLayout>
</LinearLayout>
