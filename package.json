{
  "name": "lume-player",
  "version": "0.5.9",
  "private": true,
  "description": "澄音 LUME — 局域网协同音乐播放器",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "LUME",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "server": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "build:pc-lyrics": "npm --prefix pc-lyrics run build",
    "build:all": "npm run build:pc-lyrics && npm run build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "package:win": "npm run build:all && electron-builder --win portable --x64",
    "package:dir": "npm run build:all && electron-builder --win --dir --x64"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "music-metadata": "^11.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  },
  "build": {
    "appId": "local.lume.player",
    "productName": "Lume",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "shared/**/*",
      "mobile/player-assets/player/listening.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false,
      "icon": "resources/lume.ico"
    },
    "artifactName": "Lume-${version}-Windows.${ext}"
  }
}
